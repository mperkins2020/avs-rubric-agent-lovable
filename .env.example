# DOCUMENTATION ONLY — this file supplies no runtime values.
# The tracked .env holds PUBLIC frontend values only (VITE_*, written by the Lovable/Supabase connection).
# Never put secrets in .env or in Git. Use a local, untracked .env.local for anything private.
# Production/edge-function secrets (FIRECRAWL_API_KEY, LOVABLE_API_KEY, SUPABASE_SERVICE_ROLE_KEY)
# live in Lovable Cloud secrets, not in this file.

# Public (browser-exposed) Supabase settings used by the Vite build — values come from your Supabase project settings.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<supabase-anon-or-publishable-key>
VITE_SUPABASE_PROJECT_ID=<project-ref>

# Optional — only for local dev tools in tools/scraper-dev (e.g. `npm run preview-urls`).
# Use your own Firecrawl key; it must stay local and uncommitted.
# FIRECRAWL_API_KEY=<your-firecrawl-key>
